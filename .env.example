# Copy to .env and fill in. .env is git-ignored; never commit real passwords.
DB_URL=jdbc:postgresql://localhost:5432/city_navigator
DB_USER=navigator
DB_PASSWORD=change-me

# Optional: three sample incidents for a demo
DEMO_DATA=true
# Optional: when set, reporting incidents and adding places need the X-Admin-Token header
ADMIN_TOKEN=

# Optional: nationwide routing and search through public OpenStreetMap services (on by default)
# EXTERNAL_SERVICES=false
# ROUTING_SERVICE_URL=https://routing.openstreetmap.de/routed-{profile}/route/v1/driving/
# GEOCODER_URL=https://photon.komoot.io

# Optional: the car roads of Turkey for the own engine (scripts/build-national-graph.sh); needs about 1 GB of heap
# NATIONAL_GRAPH_FILE=data/turkey-car.graph
# Optional: Istanbul's live traffic index (İBB); the usual traffic profile is bundled and works without it
# TRAFFIC_INDEX_URL=https://api.ibb.gov.tr/tkmservices/api/TrafficData/v1/TrafficIndexHistory/
