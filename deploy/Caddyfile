# HTTPS for the site address (certificates from Let's Encrypt, renewed by Caddy), compressed responses, and the
# application behind it. Browsers only share the location over HTTPS, so navigation needs this.
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	reverse_proxy app:8080
}
